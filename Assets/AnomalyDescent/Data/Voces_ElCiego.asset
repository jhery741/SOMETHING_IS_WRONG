    minStage: 0
    maxStage: 4
    roomId: 
    check: 0
    options: []
  - id: pers_02
    context: 18
    text: "\xA1No corras!"
    clip: {fileID: 0}
    minStage: 0
    maxStage: 4
    roomId: 
    check: 0
    options: []
  - id: perd_01
    context: 19
    text: "\xBFD\xF3nde te has metido?"
