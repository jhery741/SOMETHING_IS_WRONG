  - id: resp_verdad
    context: 13
    text: "Lo s\xE9."
    clip: {fileID: 0}
    minStage: 0
    maxStage: 4
    roomId: 
    check: 0
    options: []
  - id: resp_mentira
    context: 14
    text: Mientes.
    clip: {fileID: 0}
    minStage: 0
    maxStage: 4
    roomId: 
    check: 0
    options: []
  - id: resp_silencio
    context: 15
    text: "\xBFNo me contestas?"
    clip: {fileID: 0}
    minStage: 0
    maxStage: 4
    roomId: 
    check: 0
    options: []
  - id: juego_01
    context: 16
    text: "Tres golpes. Encu\xE9ntrame."
    clip: {fileID: 0}
    minStage: 0
    maxStage: 4
    roomId: 
    check: 0
    options: []
  - id: apar_01
    context: 17
    text: Te oigo. Te oigo muy cerca.
