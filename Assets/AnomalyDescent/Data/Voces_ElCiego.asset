    minStage: 3
    maxStage: 4
    roomId: 
    check: 0
    options: []
  - id: apar_02
    context: 17
    text: No te muevas.
    clip: {fileID: 0}
    minStage: 3
    maxStage: 4
    roomId: 
    check: 0
    options: []
  - id: pers_01
    context: 18
    text: "\xA1Ah\xED est\xE1s!"
