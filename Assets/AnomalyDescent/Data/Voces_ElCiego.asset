  - id: preg_donde
    context: 12
    text: "\xBFD\xF3nde est\xE1s?"
    clip: {fileID: 0}
    minStage: 1
    maxStage: 4
    roomId: 
    check: 1
    options:
    - label: "\xABEn {habitacion}.\xBB"
      kind: 0
